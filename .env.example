# TruthLens AI - environment configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file. Values here are safe defaults.

# Flask / backend
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Port used by the backend (Railway injects PORT automatically)
PORT=5000

# SQLite database location (relative to the backend/ folder)
DATABASE_URL=sqlite:///truthlens.db

# ML artifacts location (relative to the repository root)
ML_ARTIFACTS_DIR=ml/artifacts

# Dataset directory (raw ISOT CSVs go here)
DATASET_RAW_DIR=ml/data/raw

# Analysis limits
MAX_ARTICLE_LENGTH=12000
MAX_HEADLINE_LENGTH=500

# External APIs (optional; set real values in .env, never commit them)
# Gemini is used as an optional AI-text detection backend; when unset the
# detector falls back to the offline heuristic + bigram model.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# NewsAPI powers the trending-news analyzer.
NEWSAPI_KEY=your-newsapi-key

# ---- Production deployment (Railway backend + Vercel frontend) ----
# Railway (set these in the Railway project's Variables tab; PORT is injected):
#   SECRET_KEY=<long-random-string>
#   CORS_ORIGINS=https://<your-app>.vercel.app
#   DATABASE_URL=sqlite:///truthlens.db   (or a Railway Postgres URL)
#   ML_ARTIFACTS_DIR defaults to the repo's ml/artifacts/ - no need to set it.
# Vercel (set in the Vercel project's Environment Variables):
#   VITE_API_URL=https://<your-backend>.up.railway.app
# When VITE_API_URL is empty the frontend calls /api on the same origin.
