{
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "api/index.py",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "memory": 1024
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}